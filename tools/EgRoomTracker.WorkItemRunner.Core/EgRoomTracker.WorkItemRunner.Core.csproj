<Project Sdk="Microsoft.NET.Sdk">
  <!-- ViewModels et services de WorkItemRunner (EGR-20), sans aucun type WPF : testables sous Linux. -->
  <PropertyGroup>
    <TargetFramework>$(CoreTargetFramework)</TargetFramework>
    <RootNamespace>EgRoomTracker.WorkItemRunner</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EgRoomTracker.WorkItemRunner.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Validation de result.json contre docs/schema/result.schema.json (même paquet que src/Tests). -->
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EgRoomTracker.Aps\EgRoomTracker.Aps.csproj" />
    <!-- SettingsReader : validation locale de settings.json avant soumission (mêmes règles que l'add-in). -->
    <ProjectReference Include="..\..\src\Application\EgRoomTracker.Application.csproj" />
  </ItemGroup>
</Project>
