<Window x:Class="EgRoomTracker.WorkItemRunner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EG_ROOM_TRACKER · WorkItemRunner" Width="1360" Height="900" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- Première colonne de l'arbre des résultats : retrait selon la profondeur et flèche de dépliage (TableRow). -->
    <DataTemplate x:Key="TreeToggleCell">
      <StackPanel Orientation="Horizontal">
        <Border Width="{Binding Indent}" />
        <Button Content="{Binding Glyph}" Click="OnToggleRow" Width="26" Padding="0" BorderThickness="0" Background="Transparent"
                FontSize="15" FontWeight="Bold" Foreground="#2563EB" Cursor="Hand" ToolTip="Afficher ou masquer les portes et équipements"
                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>
    <!-- ==== Arbre TRC (maquette Figma v2 « paramètres en colonnes ») ==== -->
    <!-- Flèche ▶ / ▼ : bouton à bascule réduit à son glyphe. -->
    <Style x:Key="ArrowToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#2563EB" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="6,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ItemsPanelTemplate x:Key="HorizontalPanel">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
    <!-- Bande d'en-tête d'une section (Identification, Paramètres d'occurrence, Paramètres de type). -->
    <DataTemplate x:Key="TrcBand">
      <Border Width="{Binding Width}" Background="{Binding BandBackground}" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" Padding="8,4" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TrcHeaderCell">
      <TextBlock Text="{Binding Text}" Width="{Binding Width}" Padding="8,5" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
    </DataTemplate>
    <DataTemplate x:Key="TrcCell">
      <Border Width="{Binding Width}" Background="{Binding Background}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Text}" Padding="8,5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
      </Border>
    </DataTemplate>
    <!-- En-tête à deux niveaux : bandes puis colonnes ; Tag = largeur de la colonne de flèche. -->
    <DataTemplate x:Key="TrcHeader">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Background="White">
          <Border Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
          <ItemsControl ItemsSource="{Binding Bands}" ItemTemplate="{StaticResource TrcBand}" ItemsPanel="{StaticResource HorizontalPanel}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Background="#F1F5F9">
          <Border Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
          <ItemsControl ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource TrcHeaderCell}" ItemsPanel="{StaticResource HorizontalPanel}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <!-- Sous-tableau d'une catégorie : bandeau (flèche, pastille, nombre) puis en-tête à bandes et lignes. -->
    <DataTemplate x:Key="TrcGroup">
      <StackPanel Margin="0,4,0,4" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <ToggleButton Style="{StaticResource ArrowToggle}" FontSize="11" IsChecked="{Binding IsExpanded}" Content="{Binding Glyph}" />
          <Border Background="{Binding ChipBackground}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding CountText}" Foreground="#64748B" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left"
                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ContentControl Content="{Binding Header}" ContentTemplate="{StaticResource TrcHeader}" Tag="0" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource TrcCell}" ItemsPanel="{StaticResource HorizontalPanel}"
                                  ToolTip="{Binding BimId}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
    <!-- Pièce : ligne du tableau des pièces, puis, dépliée, un sous-tableau par catégorie. -->
    <DataTemplate x:Key="TrcRoom">
      <StackPanel>
        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="White" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                  <Setter Property="Background" Value="#EFF6FF" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal">
            <Border Width="36">
              <ToggleButton Style="{StaticResource ArrowToggle}" IsChecked="{Binding IsExpanded}" Content="{Binding Glyph}" ToolTip="Afficher les objets de la pièce" />
            </Border>
            <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource TrcCell}" ItemsPanel="{StaticResource HorizontalPanel}"
                          ToolTip="{Binding BimId}" />
          </StackPanel>
        </Border>
        <Border Background="#FAFBFC" Padding="40,8,12,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource TrcGroup}" />
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0F172A" Padding="20,14">
      <StackPanel>
        <TextBlock Text="WorkItemRunner" Foreground="White" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Foreground="#94A3B8">
          <Run Text="Identifiants : " /><Run Text="{Binding CredentialSource, Mode=OneWay}" />
          <Run Text="   ·   WorkItem en cours : " /><Run Text="{Binding WorkItemStatus, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="20,8"
            Visibility="{Binding HasConfigurationBanner, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding ConfigurationBanner, Mode=OneWay}" Foreground="#78350F" TextWrapping="Wrap" />
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="12,6">
      <TextBlock Text="{Binding Status}" />
    </Border>

    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Colonne gauche : lancement -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Activity" Style="{StaticResource Heading}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Version Revit" Style="{StaticResource Hint}" />
                  <ComboBox ItemsSource="{Binding RevitVersions}" SelectedItem="{Binding SelectedRevitVersion}" Margin="0,2,8,2" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Alias" Style="{StaticResource Hint}" />
                  <ComboBox ItemsSource="{Binding Aliases}" SelectedItem="{Binding SelectedAlias}" Margin="0,2,0,2" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Nickname APS (APS_NICKNAME)" Style="{StaticResource Hint}" Margin="0,6,0,0" />
              <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Bucket OSS (APS_BUCKET, transient 24 h)" Style="{StaticResource Hint}" Margin="0,6,0,0" />
              <TextBox Text="{Binding BucketKey, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Racine du dépôt (définitions, schéma)" Style="{StaticResource Hint}" Margin="0,6,0,0" />
              <TextBox Text="{Binding RepositoryRoot, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Entrées" Style="{StaticResource Heading}" />
              <TextBlock Text="ZIP de la maquette (RVT principal et liens, docs/INPUTS.md)" Style="{StaticResource Hint}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="…" Style="{StaticResource Secondary}" Command="{Binding BrowseZipCommand}" />
                <TextBox Text="{Binding ZipPath, UpdateSourceTrigger=PropertyChanged}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Ouvrir…" Style="{StaticResource Secondary}" Command="{Binding OpenSettingsCommand}" />
                  <Button Content="Exemple" Style="{StaticResource Secondary}" Command="{Binding LoadExampleSettingsCommand}" Margin="0,2,0,2" />
                </StackPanel>
                <TextBlock Text="settings.json" Style="{StaticResource Hint}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding SettingsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                       FontFamily="Consolas" Height="220" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,4" />
              <TextBlock Text="{Binding SettingsValidation}" Style="{StaticResource Hint}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Exécution" Style="{StaticResource Heading}" />
              <DockPanel>
                <TextBlock Text="Suivi toutes les (s)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" />
              </DockPanel>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="Lancer…" Command="{Binding RunCommand}" />
                <Button Content="Arrêter le suivi" Style="{StaticResource Secondary}" Command="{Binding StopFollowingCommand}" />
                <Button Content="Annuler le WorkItem…" Style="{StaticResource DangerButton}" Command="{Binding CancelWorkItemCommand}" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                         Text="Le plan (fichiers, objets OSS, Activity) est affiché avant tout téléversement : un WorkItem est facturé. Aucune URL signée n'est affichée." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Colonne droite : historique et résultats -->
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Historique" Style="{StaticResource Heading}" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button Content="Actualiser" Style="{StaticResource Secondary}" Command="{Binding RefreshHistoryCommand}" />
              <Button Content="Récupérer" ToolTip="Relit le statut du WorkItem sélectionné et télécharge rapport et result.json (même après un redémarrage)" Command="{Binding RecoverCommand}" />
              <Button Content="Exporter…" Command="{Binding ExportRunCommand}" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Summary" BorderThickness="0" />
          </DockPanel>
        </Border>

        <TabControl Grid.Column="2">
          <TabItem Header="Résultat">
            <DockPanel Margin="8">
              <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Result.Summary}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock><Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" : " /><Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander DockPanel.Dock="Bottom" Header="Écarts au schéma result.schema.json" Margin="0,8,0,0">
                <ListBox ItemsSource="{Binding Result.SchemaErrors}" MaxHeight="120" />
              </Expander>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="8" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Arbre pièces → portes / équipements ; colonnes générées depuis les clés du résultat (MainWindow.xaml.cs).
                     Pas de tri : il casserait l'ordre de l'arbre. -->
                <DataGrid x:Name="RoomsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserSortColumns="False" MouseDoubleClick="OnRoomsGridDoubleClick">
                  <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                      <Style.Triggers>
                        <!-- Portes et équipements (lignes enfants) en gris clair, sous leur pièce. -->
                        <DataTrigger Binding="{Binding Depth}" Value="1">
                          <Setter Property="Background" Value="#F1F5F9" />
                          <Setter Property="Foreground" Value="#334155" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGrid.RowStyle>
                </DataGrid>
                <!-- Fichier TRC : arbre de tableaux à bandes (TrcTree, MainWindow.xaml.cs). -->
                <DockPanel x:Name="TrcPanel" Visibility="Collapsed">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Tout déplier" Click="OnExpandAll" Padding="10,3" Margin="0,0,6,0" />
                    <Button Content="Tout replier" Click="OnCollapseAll" Padding="10,3" Margin="0,0,14,0" />
                    <TextBlock Text="Afficher :" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding Filters}" ItemsPanel="{StaticResource HorizontalPanel}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{Binding ChipBackground}" CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                            <CheckBox IsChecked="{Binding IsChecked}" VerticalContentAlignment="Center">
                              <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="11" />
                            </CheckBox>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                      <!-- En-tête du tableau des pièces : défile horizontalement avec les lignes (MainWindow.xaml.cs). -->
                      <ScrollViewer x:Name="TrcHeaderScroll" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding RoomHeader}" ContentTemplate="{StaticResource TrcHeader}" Tag="36" />
                      </ScrollViewer>
                      <ScrollViewer x:Name="TrcRowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ScrollChanged="OnTrcRowsScrolled">
                        <ItemsControl ItemsSource="{Binding Rooms}" ItemTemplate="{StaticResource TrcRoom}" />
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </DockPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Result.Anomalies}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180" />
                    <DataGridTextColumn Header="Gravité" Binding="{Binding Severity}" Width="70" />
                    <DataGridTextColumn Header="Portée" Binding="{Binding Scope}" Width="80" />
                    <DataGridTextColumn Header="Élément" Binding="{Binding ElementId}" Width="80" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </DockPanel>
          </TabItem>
          <TabItem Header="Rapport APS">
            <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="8"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
          </TabItem>
          <TabItem Header="Journal">
            <ListBox ItemsSource="{Binding Log}" BorderThickness="0" FontFamily="Consolas" FontSize="12" Margin="8">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                    <Run Text="{Binding Level, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Message, Mode=OneWay}" />
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
