# Modèle de configuration APS pour DaManager, WorkItemRunner et deploy.py (voir docs/OUTILS.md).
# Copier ce fichier en .env (ignoré par git), renseigner les valeurs, puis charger avec : . .\load-env.ps1
# Ne jamais versionner .env ni coller son contenu dans un ticket, un message ou un log.

# Identifiants de l'application APS (OAuth 2-legged), utilisés par DaManager et WorkItemRunner.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Nickname de l'application APS (obligatoire). À définir une seule fois, avant toute publication.
APS_NICKNAME=

# Bucket OSS des entrées/sorties des WorkItems (recommandé). Défaut : egr-workitems-<empreinte de l'ID client>.
APS_BUCKET=

# Optionnel : jeton 2-legged temporaire (scope code:all), seulement pour deploy.py --apply.
APS_TOKEN=

# Optionnel : URL de l'Automation API (défaut : https://developer.api.autodesk.com/da/us-east/v3).
APS_DA_BASE_URL=
